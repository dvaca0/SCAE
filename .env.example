# =============================================================================
# SCAE — configuración de entorno
# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repo.
# =============================================================================

# --- Seguridad ---------------------------------------------------------------
# Obligatoria en producción; en desarrollo se deriva una clave local si falta.
# Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
SCAE_SECRET_KEY=
SCAE_ENVIRONMENT=development
# Pon true cuando la plataforma se sirva detrás de HTTPS.
SCAE_COOKIE_SECURE=false

# --- Base de datos -----------------------------------------------------------
# Desarrollo: SQLite. Producción: postgresql+psycopg://usuario:clave@host/scae
SCAE_DATABASE_URL=sqlite:///./backend/data/scae.db

# --- Reconocimiento ----------------------------------------------------------
# yolo_easyocr = pipeline real | stub = sin modelos de visión (arranque rápido)
SCAE_RECOGNITION_BACKEND=yolo_easyocr
SCAE_DETECTOR_MODEL=yolov5l.pt
SCAE_OCR_USE_GPU=false
# Por debajo de este valor la decisión NO se automatiza: va a revisión manual.
SCAE_REVIEW_CONFIDENCE_THRESHOLD=0.55

# --- Notificaciones ----------------------------------------------------------
# Sin estos valores las incidencias se registran pero NO envían correo, y la
# interfaz lo indica explícitamente. No inventes credenciales.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# =============================================================================
# Legado — sólo lo usa el prototipo v1 (app.py / dashboard/dashboard.py)
# =============================================================================
FLASK_SECRET_KEY=
DATABASE_URL=sqlite:///vehicular_access_control.db
